{
  "trailingSlash": "never",

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/.well-known/*",
      "/robots.txt",
      "/sitemap.xml",
      "/site.webmanifest",
      "/manifest.json",
      "/favicon.ico",
      "/apple-touch-icon.png",
      "/sw.js",
      "/src/*",
      "/assets/*",
      "/docs/*",
