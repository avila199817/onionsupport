{
  "trailingSlash": "never",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/.well-known/*",
      "/robots.txt",
      "/sitemap.xml",
      "/site.webmanifest",
      "/manifest.json",
      "/favicon.ico",
      "/apple-touch-icon.png",
      "/sw.js",
      "/src/*",
      "/assets/*",
      "/docs/*",
      "/*.{js,mjs,css,png,jpg,jpeg,gif,svg,webp,avif,bmp,ico,json,txt,xml,webmanifest,map,woff,woff2,ttf,eot,otf,pdf,mp4,webm,mp3,wav,ogg,wasm}"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "statusCode": 404
    },
    {
      "route": "/.auth/*",
      "statusCode": 404
    },
    {
      "route": "/staticwebapp.config.json",
      "statusCode": 404
    },
    {
      "route": "/.env*",
      "statusCode": 404
    },
    {
      "route": "/.git/*",
      "statusCode": 404
    },
    {
      "route": "/.github/*",
      "statusCode": 404
    },
    {
      "route": "/.vscode/*",
      "statusCode": 404
    },
    {
      "route": "/.idea/*",
      "statusCode": 404
    },
    {
      "route": "/docs/*",
      "statusCode": 404
    },
    {
      "route": "/config/*",
      "statusCode": 404
    },
    {
      "route": "/node_modules/*",
      "statusCode": 404
    },
    {
      "route": "/package.json",
      "statusCode": 404
    },
    {
      "route": "/package-lock.json",
      "statusCode": 404
    },
    {
      "route": "/pnpm-lock.yaml",
      "statusCode": 404
    },
    {
      "route": "/yarn.lock",
      "statusCode": 404
    },
    {
      "route": "/vite.config.*",
      "statusCode": 404
    },
    {
      "route": "/webpack.config.*",
      "statusCode": 404
    },
    {
      "route": "/README*",
      "statusCode": 404
    },
    {
      "route": "/CHANGELOG*",
      "statusCode": 404
    },
    {
      "route": "/LICENSE*",
      "statusCode": 404
    },
    {
      "route": "/sitemap.xml",
      "statusCode": 404
    },
    {
      "route": "/apple-touch-icon.png",
      "statusCode": 404
    },
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    },
    {
      "route": "/src/*",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/site.webmanifest",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/favicon.ico",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Robots-Tag": "noindex, nofollow",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
    "Content-Security-Policy": "upgrade-insecure-requests; default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self'; font-src 'self' data:; img-src 'self' data: blob: https://api.onionit.net https://*.onionit.net https://*.blob.core.windows.net; media-src 'self' data: blob: https://*.blob.core.windows.net; connect-src 'self' https://api.onionit.net https://*.onionit.net https://*.blob.core.windows.net wss://api.onionit.net wss://*.onionit.net; manifest-src 'self'; worker-src 'self';"
  },
  "mimeTypes": {
    ".mjs": "application/javascript",
    ".webmanifest": "application/manifest+json"
  }
}
